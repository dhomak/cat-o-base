        }
      }
    },
    "%@: %@. Adding keeps everything you have, so importing the same backup twice makes duplicates. Replacing deletes your current data first." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@. При добавлении всё имеющееся сохраняется, поэтому повторный импорт той же копии создаст дубликаты. При замене текущие данные сначала удаляются."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@. Під час додавання все наявне зберігається, тому повторний імпорт тієї ж копії створить дублікати. Під час заміни поточні дані спершу видаляються."
          }
        }
      }
    },
    "%@: click to preview. Right-click to rename or delete." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: нажмите для просмотра. Правая кнопка — переименовать или удалить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: клацніть для перегляду. Права кнопка — перейменувати або видалити."
          }
        }
      }
    },
